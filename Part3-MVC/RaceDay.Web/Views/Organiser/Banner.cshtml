@model BannerViewModel
@{
    var e = Model.Event;
    ViewData["Title"] = $"Banner · {e.Name}";
    var hasImage = !string.IsNullOrEmpty(e.ImageUrl);
}

<section class="rd-page-head">
    <div class="container">
        <a class="text-white-50 small text-decoration-none" asp-action="Dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a>
        <h1>Event banner</h1>
        <p>@e.Name</p>
    </div>
</section>

<div class="container" style="max-width:56rem">
    <div class="row g-4">
        <div class="col-md-7">
            <div class="rd-card">
                <div class="rd-card-banner @(hasImage ? "" : UiHelpers.EventTypeClass(e.EventType))"
                     style="@(hasImage ? $"background-image:url('{e.ImageUrl}')" : null)">
                    @if (!hasImage)
                    {
                        <i class="bi @UiHelpers.EventTypeIcon(e.EventType)"></i>
                    }
                </div>
                <div class="rd-card-body">
                    @if (hasImage)
                    {
                        <div class="small text-muted">Stored in Azure Blob Storage at:</div>
                        <code class="small text-break">@e.ImageUrl</code>
                    }
                    else
                    {
                        <div class="text-muted">No banner yet. Events without one show a coloured placeholder.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-5">
            <form asp-action="Banner" asp-route-id="@e.EventId" method="post" enctype="multipart/form-data" class="rd-form-card">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <label asp-for="Image" class="form-label">Upload a new banner</label>
                <input asp-for="Image" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="Image" class="text-danger small"></span>
                <p class="small text-muted mt-2">JPG, PNG or WebP, up to 5 MB. A wide photo (about 1600 × 800) works best.</p>
                <button type="submit" class="btn btn-rd w-100"><i class="bi bi-cloud-arrow-up"></i> Upload to Azure</button>
            </form>
        </div>
    </div>
</div>