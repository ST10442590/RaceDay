@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
    var isOrganiser = Model.Role == Roles.Organiser;
}
<div class="container">
    <div class="rd-auth" style="max-width:44rem">
        <div class="text-center mb-4">
            <h1 class="mb-0">Join RaceDay</h1>
            <p class="text-muted">Enter races as a participant, or run your own events as an organiser.</p>
        </div>
        <div class="rd-form-card">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <label class="form-label d-block">I am registering as</label>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <input type="radio" class="btn-check" asp-for="Role" value="@Roles.Participant" id="role-participant" />
                        <label class="rd-category-option h-100" for="role-participant">
                            <span><strong><i class="bi bi-person-arms-up"></i> Participant</strong><span class="d-block small text-muted">Enter races and track my results</span></span>
                        </label>
                    </div>
                    <div class="col-6">
                        <input type="radio" class="btn-check" asp-for="Role" value="@Roles.Organiser" id="role-organiser" />
                        <label class="rd-category-option h-100" for="role-organiser">
                            <span><strong><i class="bi bi-megaphone"></i> Organiser</strong><span class="d-block small text-muted">Create and manage events</span></span>
                        </label>
                    </div>
                </div>

                <div class="mb-3 @(isOrganiser ? "" : "d-none")" id="invite-code">
                    <label asp-for="OrganiserInviteCode" class="form-label"></label>
                    <input asp-for="OrganiserInviteCode" class="form-control" />
                    <span asp-validation-for="OrganiserInviteCode" class="text-danger small"></span>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateOfBirth" class="form-label"></label>
                        <input asp-for="DateOfBirth" class="form-control" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Gender" class="form-label"></label>
                        <select asp-for="Gender" class="form-select">
                            <option value="">Prefer not to say</option>
                            <option>Female</option>
                            <option>Male</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-rd btn-lg w-100 mt-4">Create account</button>
            </form>
            <p class="text-center small mt-3 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Show the invite code box only for Organisers.
        document.querySelectorAll('input[name="Role"]').forEach(function (radio) {
            radio.addEventListener('change', function () {
                document.getElementById('invite-code').classList.toggle('d-none', this.value !== 'Organiser');
            });
        });
    </script>
}