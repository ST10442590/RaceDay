@model EventResultsViewModel
@{
    ViewData["Title"] = $"Results \u00B7 {Model.Event.Name}";
    var myId = Context.Session.GetUserId();
}

<section class="rd-page-head">
    <div class="container">
        <a class="text-white-50 small text-decoration-none" asp-action="Details" asp-route-id="@Model.Event.EventId"><i class="bi bi-arrow-left"></i> @Model.Event.Name</a>
        <h1>Results</h1>
        <p>@UiHelpers.Date(Model.Event.EventDate) &middot; @Model.Event.VenueName, @Model.Event.City</p>
    </div>
</section>

<div class="container">
    @if (Model.Results.Count == 0)
    {
        <div class="rd-empty">
            <i class="bi bi-hourglass"></i>
            <h3>No results yet</h3>
            <p class="mb-0">Results appear here once the organiser has captured them.</p>
        </div>
    }

    @foreach (var category in Model.Results.GroupBy(r => r.CategoryName))
    {
        var finishers = category.Count(r => r.ResultStatus == ResultStatuses.Finished);
        <div class="d-flex justify-content-between align-items-baseline mt-4 mb-2">
            <h2 class="m-0">@category.Key</h2>
            <span class="text-muted small">@finishers finisher@(finishers == 1 ? "" : "s")</span>
        </div>
        <div class="rd-table">
            <table class="table align-middle">
                <thead><tr><th style="width:5rem">Pos</th><th>Name</th><th>Race no.</th><th>Time</th><th class="text-end">Status</th></tr></thead>
                <tbody>
                    @foreach (var r in category)
                    {
                        var podium = r.FinishPosition is >= 1 and <= 3 ? $"rd-podium-{r.FinishPosition}" : "";
                        <tr class="@(r.ParticipantId == myId ? "table-warning" : "")">
                            <td class="rd-position @podium">@(r.FinishPosition is null ? "\u2013" : UiHelpers.Ordinal(r.FinishPosition.Value))</td>
                            <td>@r.ParticipantName</td>
                            <td>@r.RaceNumber</td>
                            <td class="fw-semibold">@UiHelpers.FinishTime(r.FinishTime)</td>
                            <td class="text-end"><span class="rd-badge @UiHelpers.ResultStatusClass(r.ResultStatus)">@ResultStatuses.Describe(r.ResultStatus)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>